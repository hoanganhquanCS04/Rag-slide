# Chép thành .env rồi điền khoá:   cp .env.example .env
# .env nằm trong .gitignore — KHÔNG commit khoá thật.

# --- API (mọi lần gọi LLM, embedding đi qua đây; VLM cũng vậy trừ khi khai VLM_BASE_URL)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.yescale.io/v1

# --- VLM chạy cổng riêng (① VlmPipeline đọc từng trang) — bỏ trống = đi chung OPENAI_BASE_URL.
# Gemma local qua vLLM: VLM_MODEL phải trùng --served-model-name của vLLM.
# KHÔNG trỏ OPENAI_BASE_URL về vLLM: vLLM không chạy embedding, S5 sẽ hỏng.
# VLM_BASE_URL=http://localhost:8000/v1
# VLM_API_KEY=                      # chỉ cần khi vLLM bật --api-key
# VLM_SOFT_TOKENS=1120              # chỉ Gemma 4 / vLLM: token ảnh (mặc định 280 đọc sai dấu)

# --- Model — đổi model sửa ở đây, KHÔNG sửa trong code
VLM_MODEL=gemini-3.8-flash          # ① VLM đọc cả trang: bố cục + chữ + bảng + mô tả ảnh (parsing/docling_run.py)
LLM_MODEL=gemini-3.5-flash-lite     # hỏi đáp (try_ask.py) + kịch bản S4
EMBEDDER=openai                     # ④b biến thể embedder (src/index/embedder/) — hiện chỉ có openai
EMBED_MODEL=text-embedding-3-small  # ④ nhúng vector + tìm kiếm — đổi là phải nhúng lại toàn bộ

# --- Kho
VECTOR_DB=chroma                    # chroma (ghi đĩa) | inmem (RAM, bỏ trống = inmem)
CHROMA_PATH=out/index/chroma        # tính từ gốc repo
# SPARSE_INDEX=rank_bm25            # index từ khoá BM25 — hiện chỉ có rank_bm25 (mặc định)
